{
  "name": "cookie-cutter-generator",
  "version": "0.1.0",
  "description": "Modern web-based cookie cutter generator with Next.js and Three.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --require ./scripts/tsx-windows-user-shim.cjs --import tsx --conditions=import --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "replay:references": "tsx --conditions=import --test tests/reference-svg-replay.test.ts",
    "validate:references": "node scripts/validate-reference-manifest.mjs",
    "export": "next export"
  },
  "dependencies": {
    "@react-three/drei": "^9.80.0",
    "@react-three/fiber": "^8.14.0",
    "autoprefixer": "^10.4.16",
    "clipper2-ts": "2.0.1-18",
    "clsx": "^2.0.0",
    "lucide-react": "^0.292.0",
    "next": "^14.0.0",
    "openai": "^5.13.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.0",
    "three": "^0.155.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/three": "^0.155.0",
    "eslint": "^8.53.0",
    "eslint-config-next": "^14.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "cookie-cutter",
    "3d-printing",
    "nextjs",
    "threejs",
    "svg",
    "stl",
    "web-app"
  ],
  "author": "Cookie Cutter Generator",
  "license": "MIT"
}
